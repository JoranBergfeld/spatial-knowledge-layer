#!/bin/sh
# What CI runs (.github/workflows/ci.yml), locally, in the same order. Stops at the first failure.
# The Postgres tests skip unless SPATIAL_TEST_DATABASE_URL is set (see Develop in the README).
set -e
cd "$(dirname "$0")/.."

uv run ruff check .
uv run ruff format --check .
uv run mdformat --check README.md
uv run mypy
gold_out=$(mktemp -d)
uv run python -I -S gold cobie \
  --workbook packages/ingest/tests/handover_fixture/handover.xlsx \
  --ocr packages/ingest/tests/handover_fixture/ocr \
  --out "$gold_out/gold.json" >/dev/null
rm -rf "$gold_out"
uv run pytest -q
