# syntax=docker/dockerfile:1

# Image for the ingestion CLI. It holds the pipeline and nothing of the service.
#
#     docker run --rm -v "$PWD/bundles:/bundles" \
#         -e AZURE_OPENAI_ENDPOINT -e AZURE_OPENAI_API_KEY \
#         -e SPATIAL_COMPOSITION_DEPLOYMENT -e SPATIAL_EMBEDDING_BASE_URL #         -e SPATIAL_EMBEDDING_API_KEY -e SPATIAL_EMBEDDING_MODEL -e SPATIAL_EMBEDDING_DIMENSIONS \
#         <image> build --date 2026-09-15 --out /bundles
#     docker run --rm -v "$PWD/bundles:/bundles" -e SPATIAL_DATABASE_URL \
#         -e AZURE_SEARCH_ENDPOINT -e AZURE_SEARCH_API_KEY \
#         <image> load --date 2026-09-15 --out /bundles
#
# Built and pushed to GHCR by .github/workflows/publish-ingest-image.yml.
FROM python:3.12-slim

# uv ships as a static binary in its own image. Pinned to the 0.11 line we develop against.
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /bin/

# pyosmium's wheel links against the system expat, which slim leaves out.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

# Dependencies first, so this layer survives source-only edits.
COPY pyproject.toml uv.lock ./
COPY packages/core/pyproject.toml packages/core/pyproject.toml
COPY packages/ingest/pyproject.toml packages/ingest/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace --package spatial-ingest

COPY packages/core packages/core
COPY packages/ingest packages/ingest
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --package spatial-ingest

ENV PATH="/app/.venv/bin:$PATH"

ENTRYPOINT ["ingest"]
